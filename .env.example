# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string.
# Easiest local option (no Docker/psql needed): `npx prisma dev` prints one
# for you — see README "Lokale Entwicklung". Otherwise use docker-compose.yml
# (DATABASE_URL="postgres://postgres:postgres@localhost:5432/augenfacharzt")
# or a free hosted Postgres (Neon, Supabase).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/augenfacharzt?sslmode=disable"

# Used once by `npx prisma db seed` to create the first admin account and the
# 12 default specialties. Change the password after first login.
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"

# ---- Stage 2 (not implemented yet — see README "Nicht implementiert") ----
# AI-assisted question extraction, clinical-case generation, suggested
# answers, adaptive follow-ups, image recommendations, and AI answer
# feedback all need an LLM provider key:
# ANTHROPIC_API_KEY=

# Password-reset email delivery (Stage 1 only logs the reset link to the
# server console instead of sending it):
# EMAIL_FROM="AugenFacharzt <no-reply@example.com>"
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# (or, if using Resend instead of raw SMTP:)
# RESEND_API_KEY=
